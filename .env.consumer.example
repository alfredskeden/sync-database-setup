# ─── Local CouchDB (your own local instance) ────────────
LOCAL_COUCH_USER=admin
LOCAL_COUCH_PASS=change-me-local

# ─── Remote Cloud CouchDB (the host's shared database) ──
# Get these credentials from the person hosting the cloud DB
CLOUD_COUCH_USER=admin
CLOUD_COUCH_PASS=change-me-cloud
CLOUD_HOST=192.168.1.50
CLOUD_PORT=5985

# ─── Database ────────────────────────────────────────────
DATABASE_NAME=app_data
