# ─── Local CouchDB ───────────────────────────────────────
LOCAL_COUCH_USER=admin
LOCAL_COUCH_PASS=change-me-local

# ─── Cloud CouchDB ───────────────────────────────────────
CLOUD_COUCH_USER=admin
CLOUD_COUCH_PASS=change-me-cloud

# ─── Database ────────────────────────────────────────────
DATABASE_NAME=app_data

# ─── Host address (your machine's IP or domain) ─────────
# Other users need this to connect to your cloud CouchDB.
# Set to your LAN IP (e.g. 192.168.1.50) or public domain.
HOST_ADDRESS=localhost
